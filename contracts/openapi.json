            "type": "boolean",
            "title": "Needs Rerun",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "alpha_fail",
          "t_fail"
        ],
        "title": "CounterfactualItem"
      },
      "DecisionEnum": {
        "type": "string",

          "QUALITY_REJECTED",
          "FAST_PASS",
          "AGENT_CLEARED",
          "AGENT_CONFIRMED",
          "SUSPECTED_DEFECT",
          "EVIDENCE_CONFLICT",
          "LIGHTING_SHIFT_REVIEW",
          "ALIGN_FAILED",
          "INCONCLUSIVE",
          "BUDGET_EXHAUSTED"
        ],
        "title": "DecisionPathEnum"
      },

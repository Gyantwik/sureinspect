          "simulate_darken": {
            "type": "boolean",
            "title": "Simulate Darken",
            "default": false
          },
          "simulate_glare": {
            "type": "boolean",
            "title": "Simulate Glare",
            "default": false
          },
          "alpha_fail": {
            "type": "number",

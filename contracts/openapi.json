              },
              {
                "type": "null"
              }
            ],
            "title": "File"
          },
          "sample_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sample Id"
          },
          "category": {
            "type": "string",
            "title": "Category",
            "default": "pcb1"

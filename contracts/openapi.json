          "t_pass": {
            "type": "number",
            "title": "T Pass"
          },
          "t_fail": {
            "type": "number",
            "title": "T Fail"
          },
          "alpha_pass": {
            "type": "number",
            "title": "Alpha Pass"
          },
          "alpha_fail": {
            "type": "number",
            "title": "Alpha Fail"
          },
          "n_calib": {
            "type": "integer",
            "title": "N Calib"
          },
          "report_bundle_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }

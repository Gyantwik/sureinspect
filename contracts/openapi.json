          "path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Path"
          }
        },
        "type": "object",
        "title": "Body_inspect_part_api_inspect_post"
      },
      "CalibrationInfo": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "frozen_assumption_dependent",
              "not_applicable_lighting_shift",
              "not_evaluated"
            ],
            "title": "Status"
          },
          "claim": {
            "anyOf": [
              {
                "type": "string",
                "const": "normal_marginal_upper_tail"
              },
              {
                "type": "null"
              }
            ],
            "title": "Claim"
          },
          "assumptions": {
            "type": "string",
            "title": "Assumptions"
          }
        },
        "type": "object",
        "required": [
          "status",
          "assumptions"
        ],
        "title": "CalibrationInfo"

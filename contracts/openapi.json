    "/api/trace/{id}": {
      "get": {
        "summary": "Get Trace",
        "description": "Protected trace lookup. Non-owned or unknown returns identical 404.",
        "operationId": "get_trace_api_trace__id__get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Id"

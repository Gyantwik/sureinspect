          "evaluation_summary": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evaluation Summary"
          }
        },
        "type": "object",
        "required": [
          "category",
          "t_pass",
          "t_fail",
          "alpha_pass",
          "alpha_fail",
          "n_calib"
        ],
        "title": "CalibrationSummaryResponse"
      },

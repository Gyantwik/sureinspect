          "quality": {
            "type": "number",
            "title": "Quality"
          },
          "q_min": {
            "type": "number",
            "title": "Q Min"
          },
          "rotation_deg": {
            "type": "number",
            "title": "Rotation Deg"
          },
          "scale": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scale"
          },
          "overlap": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Overlap"
          },
          "translation_px": {
            "anyOf": [
              {
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array",
                "maxItems": 2,
                "minItems": 2
              },
              {
                "type": "null"
              }
            ],
            "title": "Translation Px"
          }
        },
        "type": "object",
        "required": [
          "template_id",
          "method",
          "quality",
          "q_min",
          "rotation_deg"

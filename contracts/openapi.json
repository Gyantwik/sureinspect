    "/api/assets/{id}": {
      "get": {
        "summary": "Get Asset",
        "description": "Protected asset lookup. Non-owned or unknown returns identical 404.",
        "operationId": "get_asset_api_assets__id__get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Id"

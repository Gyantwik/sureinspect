          "n_calib": {
            "type": "integer",
            "title": "N Calib"
          },
          "sample_count": {
            "type": "integer",
            "title": "Sample Count"
          }
        },
        "type": "object",
        "required": [
          "id",
          "display_name",
          "enabled",
          "alpha_pass",
          "alpha_fail_default",
          "alpha_fail_options",
          "n_calib",
          "sample_count"
